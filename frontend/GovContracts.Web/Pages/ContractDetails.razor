@page "/contracts/{Id:guid}"
@inject GovContracts.Web.Services.ContractsApiService ContractsApi
@inject GovContracts.Web.Services.AuthSessionService AuthSession
@inject NavigationManager Navigation

<PageTitle>تفاصيل العقد</PageTitle>

<div class="mx-auto max-w-4xl space-y-6">
    <div class="rounded-3xl bg-white p-8 shadow-sm border border-slate-100">
        <div class="flex flex-wrap items-start justify-between gap-4 border-b border-slate-50 pb-6">
            <div>
                <p class="text-xs font-bold uppercase tracking-widest text-slate-400">تفاصيل العقد</p>
                <h1 class="mt-2 text-2xl font-bold text-identity-green">@(_contract?.ContractName ?? "عقد غير معروف")</h1>
                <p class="mt-1 text-sm text-slate-500">عرض معلومات العقد والمرفقات المرتبطة.</p>
            </div>
            <a href="/dashboard" class="rounded-2xl border-2 border-slate-100 bg-white px-6 py-3 text-xs font-bold text-slate-600 transition-all hover:bg-slate-50">العودة للوحة التحكم</a>
        </div>

        @if (_isLoading)
        {
            <div class="flex flex-col items-center justify-center py-16 grayscale opacity-50">
                <div class="h-12 w-12 animate-spin rounded-full border-4 border-slate-200 border-t-identity-green"></div>
                <p class="mt-4 text-sm font-bold text-slate-400">جاري تحميل التفاصيل...</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <div class="mt-6 rounded-2xl border border-identity-red/20 bg-identity-red/5 px-5 py-4 text-sm font-bold text-identity-red">
                @_statusMessage
            </div>
        }
        else if (_contract is not null)
        {
            <div class="mt-6 grid gap-6 md:grid-cols-2">
                <div class="rounded-2xl border border-slate-100 bg-slate-50/50 p-5">
                    <p class="text-xs font-bold uppercase tracking-widest text-slate-400">وصف العقد</p>
                    <p class="mt-2 text-sm text-slate-700">@_contract.ContractDescription</p>
                </div>
                <div class="rounded-2xl border border-slate-100 bg-slate-50/50 p-5">
                    <p class="text-xs font-bold uppercase tracking-widest text-slate-400">تاريخ العقد</p>
                    <p class="mt-2 text-sm font-bold text-slate-700">@_contract.ContractDate.ToString("yyyy/MM/dd")</p>
                </div>
                <div class="rounded-2xl border border-slate-100 bg-slate-50/50 p-5">
                    <p class="text-xs font-bold uppercase tracking-widest text-slate-400">قيمة العقد</p>
                    <p class="mt-2 text-sm font-bold text-slate-700">@_contract.ContractValue.ToString("N2")</p>
                </div>
                <div class="rounded-2xl border border-slate-100 bg-slate-50/50 p-5 md:col-span-2">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <p class="text-xs font-bold uppercase tracking-widest text-slate-400">مرفقات العقد</p>
                        <a class="rounded-xl border border-identity-green/20 bg-white px-4 py-2 text-[11px] font-bold text-identity-green transition-all hover:bg-identity-green hover:text-white" href="/attachment-templates">
                            تسميات المرفقات
                        </a>
                    </div>
                    @if (_contract.Attachments?.Any() == true)
                    {
                        <div class="mt-3 overflow-hidden rounded-xl border border-slate-100 bg-white">
                            <table class="min-w-full text-right text-xs">
                                <thead class="bg-slate-50 text-slate-400">
                                    <tr>
                                        <th class="px-3 py-2 font-bold uppercase tracking-wider">الاسم</th>
                                        <th class="px-3 py-2 font-bold uppercase tracking-wider text-center">الحالة</th>
                                        <th class="px-3 py-2 font-bold uppercase tracking-wider">الملف</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-slate-50">
                                    @foreach (var attachment in _contract.Attachments)
                                    {
                                        <tr>
                                            <td class="px-3 py-2 text-slate-600">@attachment.AttachmentName</td>
                                            <td class="px-3 py-2 text-center text-slate-500">
                                                @if (attachment.IsRequired)
                                                {
                                                    <span class="rounded-full bg-identity-red/10 px-2 py-1 text-[10px] font-bold text-identity-red">مطلوب</span>
                                                }
                                                else
                                                {
                                                    <span class="rounded-full bg-slate-100 px-2 py-1 text-[10px] font-bold text-slate-500">اختياري</span>
                                                }
                                            </td>
                                            <td class="px-3 py-2">
                                                @if (!string.IsNullOrWhiteSpace(attachment.AttachmentUrl))
                                                {
                                                    <a class="inline-flex items-center gap-1 text-[11px] font-bold text-identity-green hover:underline" href="@attachment.AttachmentUrl" target="_blank">
                                                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                                        استعراض
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-[11px] text-slate-400">غير مرفق</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="mt-2 text-xs text-slate-400">لا توجد مرفقات</p>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private GovContracts.Web.Models.ContractModel? _contract;
    private bool _isLoading = true;
    private string? _statusMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthSession.IsLoggedInAsync())
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        await LoadContractAsync();
    }

    private async Task LoadContractAsync()
    {
        _isLoading = true;
        _statusMessage = null;

        var contract = await ContractsApi.GetByIdAsync(Id);
        if (contract is null)
        {
            _statusMessage = "تعذر العثور على العقد المطلوب.";
            _contract = null;
        }
        else
        {
            _contract = contract;
        }

        _isLoading = false;
    }
}
