@page "/"
@page "/dashboard"
@inject GovContracts.Web.Services.ContractsApiService ContractsApi
@inject GovContracts.Web.Services.AuthSessionService AuthSession
@inject NavigationManager Navigation

<PageTitle>لوحة التحكم</PageTitle>

<div class="space-y-8">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-slate-900">لوحة التحكم</h1>
            <p class="mt-1 text-sm text-slate-400">نظرة عامة على العقود والإجراءات</p>
        </div>
        <a class="inline-flex items-center gap-2 rounded-2xl bg-identity-green px-6 py-3 text-sm font-bold text-white shadow-lg shadow-identity-green/20 transition-all hover:shadow-xl hover:shadow-identity-green/30 hover:-translate-y-0.5 active:translate-y-0" href="/contracts/add">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            <span>إضافة عقد جديد</span>
        </a>
    </div>

    <!-- Stats Cards -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-3xl bg-white p-7 shadow-sm border border-slate-100 transition-all hover:shadow-md">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-identity-green/10 text-identity-green">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            </div>
            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">إجمالي العقود</p>
            <p class="mt-2 text-4xl font-black text-slate-800">@_contracts.Count</p>
        </div>
        <div class="rounded-3xl bg-white p-7 shadow-sm border border-slate-100 transition-all hover:shadow-md">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-identity-gold/10 text-identity-gold">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">حالة المنظومة</p>
            <p class="mt-2 text-2xl font-bold text-slate-800">@(_contracts.Any() ? "نشط" : "بانتظار عقد")</p>
        </div>
        <div class="rounded-3xl bg-white p-7 shadow-sm border border-slate-100 transition-all hover:shadow-md sm:col-span-2 lg:col-span-1">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl bg-identity-green/10 text-identity-green">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            </div>
            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">آخر تحديث</p>
            <p class="mt-2 text-2xl font-bold text-slate-800">@DateTime.Now.ToString("yyyy/MM/dd")</p>
        </div>
    </div>

    <!-- Contracts Table -->
    <div class="rounded-3xl bg-white p-6 sm:p-8 shadow-sm border border-slate-100">
        <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <h2 class="text-xl font-bold text-slate-900">سجل العقود الموثقة</h2>
                <p class="text-sm text-slate-400">قائمة بجميع العقود التي تم رفعها للنظام</p>
            </div>
            <button class="inline-flex items-center gap-2 rounded-2xl border-2 border-slate-100 bg-white px-5 py-3 text-xs font-bold text-slate-600 transition-all hover:bg-slate-50 hover:border-slate-200" @onclick="LoadContractsAsync">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.586m15.414 1.586A9 9 0 1111 3.124" /></svg>
                تحديث البيانات
            </button>
        </div>

        @if (_isLoading)
        {
            <div class="flex flex-col items-center justify-center py-20">
                <div class="h-12 w-12 animate-spin rounded-full border-4 border-slate-200 border-t-identity-green"></div>
                <p class="mt-4 text-sm font-bold text-slate-400">جاري جلب الملفات...</p>
            </div>
        }
        else if (!_contracts.Any())
        {
            <div class="flex flex-col items-center justify-center py-20 text-center">
                <div class="mb-4 flex h-20 w-20 items-center justify-center rounded-full bg-slate-50 text-slate-300">
                    <svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                </div>
                <h3 class="text-lg font-bold text-slate-600">لا توجد سجلات</h3>
                <p class="mt-1 text-sm text-slate-400">ابدأ بإضافة أول عقد للمنظومة الآن</p>
                <a href="/contracts/add" class="mt-6 inline-flex items-center gap-2 rounded-2xl bg-identity-green px-6 py-3 text-sm font-bold text-white transition-all hover:opacity-90">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                    إضافة عقد جديد
                </a>
            </div>
        }
        else
        {
            <!-- Mobile card view -->
            <div class="space-y-4 md:hidden">
                @foreach (var contract in _contracts)
                {
                    <div class="rounded-2xl border border-slate-100 p-5 space-y-3">
                        <div class="flex items-center justify-between">
                            <h3 class="font-bold text-slate-700">@contract.ContractName</h3>
                            <button class="rounded-xl border border-identity-red/20 bg-white px-3 py-1.5 text-[11px] font-bold text-identity-red transition-all hover:bg-identity-red hover:text-white" @onclick="() => DeleteContractAsync(contract.Id)">حذف</button>
                        </div>
                        <div class="flex items-center gap-2 text-sm text-slate-500">
                            <svg class="h-4 w-4 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                            @contract.ContractDate.ToString("yyyy/MM/dd")
                        </div>
                        @if (!string.IsNullOrWhiteSpace(contract.AttachmentUrl))
                        {
                            <a class="inline-flex items-center gap-1.5 text-sm font-bold text-identity-green hover:underline" href="@contract.AttachmentUrl" target="_blank">
                                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                استعراض المرفق
                            </a>
                        }
                    </div>
                }
            </div>

            <!-- Desktop table view -->
            <div class="hidden md:block overflow-x-auto rounded-2xl border border-slate-100">
                <table class="min-w-full text-right text-sm">
                    <thead class="bg-slate-50 text-slate-400">
                        <tr>
                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider">مسمى العقد</th>
                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider">تاريخ التوثيق</th>
                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider">مستند العقد</th>
                            <th class="px-6 py-4 text-xs font-bold uppercase tracking-wider text-center">عمليات</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        @foreach (var contract in _contracts)
                        {
                            <tr class="transition-all hover:bg-slate-50/50">
                                <td class="px-6 py-5 font-bold text-slate-700">@contract.ContractName</td>
                                <td class="px-6 py-5 text-slate-500">
                                    <div class="flex items-center gap-2">
                                        <svg class="h-4 w-4 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                                        @contract.ContractDate.ToString("yyyy/MM/dd")
                                    </div>
                                </td>
                                <td class="px-6 py-5">
                                    @if (!string.IsNullOrWhiteSpace(contract.AttachmentUrl))
                                    {
                                        <a class="inline-flex items-center gap-1.5 font-bold text-identity-green hover:underline" href="@contract.AttachmentUrl" target="_blank">
                                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                                            استعراض
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-slate-300 italic">غير متوفر</span>
                                    }
                                </td>
                                <td class="px-6 py-5 text-center">
                                    <button class="rounded-xl border border-identity-red/20 bg-white px-4 py-2 text-[11px] font-bold text-identity-red transition-all hover:bg-identity-red hover:text-white" @onclick="() => DeleteContractAsync(contract.Id)">حذف السجل</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<GovContracts.Web.Models.ContractModel> _contracts = [];
    private bool _isLoading;

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthSession.IsLoggedInAsync())
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        await LoadContractsAsync();
    }

    private async Task LoadContractsAsync()
    {
        _isLoading = true;
        var data = await ContractsApi.GetAllAsync();
        _contracts = data.ToList();
        _isLoading = false;
    }

    private async Task DeleteContractAsync(Guid id)
    {
        var deleted = await ContractsApi.DeleteAsync(id);
        if (deleted)
        {
            await LoadContractsAsync();
        }
    }
}
