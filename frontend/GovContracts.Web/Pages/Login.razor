@page "/login"
@inject GovContracts.Web.Services.AuthApiService AuthApi
@inject GovContracts.Web.Services.AuthSessionService AuthSession
@inject NavigationManager Navigation

<PageTitle>تسجيل الدخول - بوابة العقود الحكومية</PageTitle>

<div class="flex min-h-screen items-center justify-center bg-slate-50 px-4 py-8 font-cairo">
    <div class="w-full max-w-md overflow-hidden rounded-3xl bg-white shadow-2xl transition-all duration-300">
        <div class="bg-identity-green p-10 text-center text-white relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-white/5 rounded-full -mr-16 -mt-16"></div>
            <div class="absolute bottom-0 left-0 w-24 h-24 bg-white/5 rounded-full -ml-12 -mb-12"></div>
            
            <div class="relative z-10">
                <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/10 backdrop-blur-sm">
                    <svg class="h-8 w-8 text-identity-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                </div>
                <h2 class="text-3xl font-extrabold tracking-tight">بوابة العقود</h2>
                <p class="mt-2 text-sm text-white/80">نظام إدارة العقود الذكي للمؤسسات</p>
                <div class="mt-6 flex justify-center gap-1.5">
                    <div class="h-1.5 w-12 rounded-full bg-identity-gold"></div>
                    <div class="h-1.5 w-3 rounded-full bg-identity-gold opacity-50"></div>
                </div>
            </div>
        </div>

        <div class="p-8">
            <div class="mb-8">
                 <h1 class="text-xl font-bold text-slate-900 mb-1">تسجيل الدخول</h1>
                 <p class="text-sm text-slate-500">ادخل بيانات الاعتماد الخاصة بك للوصول</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="mb-6 flex items-center gap-3 rounded-2xl border border-identity-red/20 bg-identity-red/5 px-4 py-3 text-sm text-identity-red">
                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>@_errorMessage</span>
                </div>
            }

            <EditForm class="space-y-6" Model="_model" OnValidSubmit="HandleLoginAsync">
                <div class="space-y-2">
                    <label class="block text-sm font-bold text-slate-700 mx-1">اسم المستخدم</label>
                    <div class="relative">
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4 text-slate-400">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                        </div>
                        <InputText @bind-Value="_model.Username" class="w-full rounded-2xl border-2 border-slate-100 bg-slate-50 pr-12 pl-5 py-4 text-sm outline-none transition-all placeholder:text-slate-400 focus:border-identity-green focus:bg-white" placeholder="أدخل اسم المستخدم" />
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="block text-sm font-bold text-slate-700 mx-1">كلمة المرور</label>
                    <div class="relative">
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-4 text-slate-400">
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                        </div>
                        <InputText @bind-Value="_model.Password" type="password" class="w-full rounded-2xl border-2 border-slate-100 bg-slate-50 pr-12 pl-5 py-4 text-sm outline-none transition-all placeholder:text-slate-400 focus:border-identity-green focus:bg-white" placeholder="••••••••" />
                    </div>
                </div>

                <button type="submit" class="mt-4 flex w-full items-center justify-center gap-3 rounded-2xl bg-identity-green px-8 py-4 text-sm font-bold text-white shadow-lg shadow-identity-green/20 transition-all hover:shadow-xl hover:shadow-identity-green/30 hover:-translate-y-0.5 active:translate-y-0 disabled:opacity-50 disabled:pointer-events-none" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <div class="h-5 w-5 animate-spin rounded-full border-2 border-white/30 border-t-white"></div>
                        <span>جاري التحقق...</span>
                    }
                    else
                    {
                        <span>دخول للمنصة</span>
                        <svg class="h-5 w-5 rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                        </svg>
                    }
                </button>
            </EditForm>

            <div class="mt-8 border-t border-slate-100 pt-6 text-center">
                <div class="flex items-center justify-center gap-4 mb-4">
                    <div class="h-px bg-slate-200 flex-1"></div>
                    <span class="text-[10px] text-slate-400 uppercase tracking-widest font-bold">نظام المؤسسات الحكومية</span>
                    <div class="h-px bg-slate-200 flex-1"></div>
                </div>
                <p class="text-[11px] text-slate-400">منظومة العقود المتكاملة &copy; 2026</p>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly GovContracts.Web.Models.LoginRequestModel _model = new();
    private string? _errorMessage;
    private bool _isLoading;

    private async Task HandleLoginAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        var response = await AuthApi.LoginAsync(_model);
        if (response is null)
        {
            _errorMessage = "فشل تسجيل الدخول. تأكد من البيانات.";
            _isLoading = false;
            return;
        }

        await AuthSession.SetSessionAsync(response.Token, response.DisplayName);
        Navigation.NavigateTo("/dashboard", true);
    }
}
