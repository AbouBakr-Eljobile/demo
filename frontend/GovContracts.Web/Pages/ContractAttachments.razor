@page "/contracts/{Id:guid}/attachments"
@inject GovContracts.Web.Services.ContractsApiService ContractsApi
@inject GovContracts.Web.Services.AuthSessionService AuthSession
@inject NavigationManager Navigation

<PageTitle>مرفقات العقد</PageTitle>

<div class="mx-auto max-w-4xl space-y-6">
    <div class="rounded-3xl bg-white p-8 shadow-sm border border-slate-100">
        <div class="flex flex-wrap items-start justify-between gap-4 border-b border-slate-50 pb-6">
            <div>
                <p class="text-xs font-bold uppercase tracking-widest text-slate-400">مرفقات العقد</p>
                <h1 class="mt-2 text-2xl font-bold text-identity-green">@(_contract?.ContractName ?? "عقد غير معروف")</h1>
                <p class="mt-1 text-sm text-slate-500">جدول المرفقات المطلوبة لكل عقد (اسم المرفق وحالته).</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <a href="/contracts/@Id" class="rounded-2xl border-2 border-slate-100 bg-white px-5 py-3 text-xs font-bold text-slate-600 transition-all hover:bg-slate-50">تفاصيل العقد</a>
                <a href="/dashboard" class="rounded-2xl border-2 border-slate-100 bg-white px-5 py-3 text-xs font-bold text-slate-600 transition-all hover:bg-slate-50">العودة للوحة التحكم</a>
            </div>
        </div>

        @if (_isLoading)
        {
            <div class="flex flex-col items-center justify-center py-16 grayscale opacity-50">
                <div class="h-12 w-12 animate-spin rounded-full border-4 border-slate-200 border-t-identity-green"></div>
                <p class="mt-4 text-sm font-bold text-slate-400">جاري تحميل المرفقات...</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <div class="mt-6 rounded-2xl border border-identity-red/20 bg-identity-red/5 px-5 py-4 text-sm font-bold text-identity-red">
                @_statusMessage
            </div>
        }
        else if (_contract?.Attachments?.Any() == true)
        {
            <div class="mt-6 overflow-hidden rounded-2xl border border-slate-100">
                <table class="min-w-full text-right text-sm">
                    <thead class="bg-slate-50/50 text-slate-400">
                        <tr>
                            <th class="px-6 py-4 font-bold uppercase tracking-wider">اسم المرفق</th>
                            <th class="px-6 py-4 font-bold uppercase tracking-wider text-center">الحالة</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        @foreach (var attachment in _contract.Attachments)
                        {
                            <tr>
                                <td class="px-6 py-4 text-slate-600">@attachment.AttachmentName</td>
                                <td class="px-6 py-4 text-center">
                                    @if (attachment.IsRequired)
                                    {
                                        <span class="rounded-full bg-identity-red/10 px-2 py-1 text-[11px] font-bold text-identity-red">مطلوب</span>
                                    }
                                    else
                                    {
                                        <span class="rounded-full bg-slate-100 px-2 py-1 text-[11px] font-bold text-slate-500">اختياري</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="mt-6 rounded-2xl border border-slate-100 bg-slate-50/50 px-5 py-4 text-sm text-slate-500">
                لا توجد مرفقات لهذا العقد.
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private GovContracts.Web.Models.ContractModel? _contract;
    private bool _isLoading = true;
    private string? _statusMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthSession.IsLoggedInAsync())
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        await LoadContractAsync();
    }

    private async Task LoadContractAsync()
    {
        _isLoading = true;
        _statusMessage = null;

        var contract = await ContractsApi.GetByIdAsync(Id);
        if (contract is null)
        {
            _statusMessage = "تعذر العثور على العقد المطلوب.";
            _contract = null;
        }
        else
        {
            _contract = contract;
        }

        _isLoading = false;
    }
}
