@page "/contracts/add"
@using System.ComponentModel.DataAnnotations
@inject GovContracts.Web.Services.ContractsApiService ContractsApi
@inject GovContracts.Web.Services.AttachmentTemplatesApiService AttachmentTemplatesApi
@inject GovContracts.Web.Services.AuthSessionService AuthSession
@inject NavigationManager Navigation

<PageTitle>إضافة عقد</PageTitle>

<div class="mx-auto max-w-3xl rounded-3xl bg-white p-8 shadow-sm border border-slate-100">
    <div class="mb-8 border-b border-slate-50 pb-6">
        <h1 class="text-2xl font-bold text-identity-green">إضافة عقد جديد</h1>
        <p class="mt-1 text-sm text-slate-500">الرجاء تعبئة بيانات العقد ورفع المرفق إن وجد.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <div class="mb-6 flex items-center gap-3 rounded-2xl border px-4 py-4 text-sm @(_isSuccess ? "border-identity-green/20 bg-identity-green/5 text-identity-green" : "border-identity-red/20 bg-identity-red/5 text-identity-red")">
            @if (_isSuccess) {
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            } else {
                <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            }
            <span>@_statusMessage</span>
        </div>
    }

    <EditForm class="space-y-6" Model="_model" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />

        <div class="space-y-2">
            <label class="block text-sm font-bold text-slate-700 mx-1">اسم العقد</label>
            <InputText @bind-Value="_model.ContractName" class="w-full rounded-2xl border-2 border-slate-50 bg-slate-50 px-5 py-3.5 text-sm outline-none transition-all focus:border-identity-green focus:bg-white" placeholder="أدخل مسمى العقد الرسمي" />
            <ValidationMessage For="@(() => _model.ContractName)" class="mt-1 block text-xs text-identity-red" />
        </div>

        <div class="space-y-2">
            <label class="block text-sm font-bold text-slate-700 mx-1">وصف العقد</label>
            <InputTextArea @bind-Value="_model.ContractDescription" class="w-full rounded-2xl border-2 border-slate-50 bg-slate-50 px-5 py-3.5 text-sm outline-none transition-all focus:border-identity-green focus:bg-white" placeholder="نبذة مختصرة عن تفاصيل العقد" />
            <ValidationMessage For="@(() => _model.ContractDescription)" class="mt-1 block text-xs text-identity-red" />
        </div>

        <div class="space-y-2">
            <label class="block text-sm font-bold text-slate-700 mx-1">تاريخ العقد</label>
            <InputDate @bind-Value="_model.ContractDate" class="w-full rounded-2xl border-2 border-slate-50 bg-slate-50 px-5 py-3.5 text-sm outline-none transition-all focus:border-identity-green focus:bg-white" />
            <ValidationMessage For="@(() => _model.ContractDate)" class="mt-1 block text-xs text-identity-red" />
        </div>

        <div class="space-y-2">
            <label class="block text-sm font-bold text-slate-700 mx-1">قيمة العقد</label>
            <InputNumber @bind-Value="_model.ContractValue" class="w-full rounded-2xl border-2 border-slate-50 bg-slate-50 px-5 py-3.5 text-sm outline-none transition-all focus:border-identity-green focus:bg-white" step="0.01" />
            <ValidationMessage For="@(() => _model.ContractValue)" class="mt-1 block text-xs text-identity-red" />
        </div>

        <div class="space-y-2">
            <div class="flex flex-wrap items-center justify-between gap-2">
                <label class="block text-sm font-bold text-slate-700 mx-1">مرفقات العقد</label>
                <a class="rounded-xl border border-identity-green/20 bg-white px-4 py-2 text-[11px] font-bold text-identity-green transition-all hover:bg-identity-green hover:text-white" href="/attachment-templates">
                    إدارة التسميات
                </a>
            </div>
            <div class="space-y-4">
                <div class="overflow-hidden rounded-2xl border border-slate-100">
                    <table class="min-w-full text-right text-sm">
                        <thead class="bg-slate-50/50 text-slate-400">
                            <tr>
                                <th class="px-4 py-3 font-bold uppercase tracking-wider">اسم المرفق</th>
                                <th class="px-4 py-3 font-bold uppercase tracking-wider text-center">مطلوب</th>
                                <th class="px-4 py-3 font-bold uppercase tracking-wider">الملف</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-50">
                            @if (_attachments.Count == 0)
                            {
                                <tr>
                                    <td class="px-4 py-6 text-center text-sm text-slate-400" colspan="3">لا توجد تسميات مرفقات.</td>
                                </tr>
                            }
                            else
                            {
                                @for (var index = 0; index < _attachments.Count; index++)
                                {
                                    var attachment = _attachments[index];
                                    var inputId = $"attachment-file-{index}";
                                    <tr>
                                        <td class="px-4 py-3 text-slate-600">@attachment.AttachmentName</td>
                                        <td class="px-4 py-3 text-center">
                                            @if (attachment.IsRequired)
                                            {
                                                <span class="rounded-full bg-identity-red/10 px-2 py-1 text-[11px] font-bold text-identity-red">مطلوب</span>
                                            }
                                            else
                                            {
                                                <span class="rounded-full bg-slate-100 px-2 py-1 text-[11px] font-bold text-slate-500">اختياري</span>
                                            }
                                        </td>
                                        <td class="px-4 py-3">
                                            <div class="flex items-center gap-2">
                                                <InputFile id="@inputId" OnChange="args => OnAttachmentFileSelected(attachment, args)" class="sr-only" />
                                                <label for="@inputId" class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-[11px] font-bold text-slate-600 shadow-sm transition-all hover:border-identity-green hover:text-identity-green">
                                                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                                                    رفع ملف
                                                </label>
                                                @if (attachment.AttachmentFile is not null)
                                                {
                                                    <span class="text-[11px] font-bold text-identity-gold">@attachment.AttachmentFile.Name</span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-4 pt-4">
            <button type="submit" class="flex-1 rounded-2xl bg-identity-green px-8 py-4 text-sm font-bold text-white shadow-lg transition-all hover:opacity-90 active:scale-[0.98] disabled:opacity-50" disabled="@_isSubmitting">
                @if (_isSubmitting)
                {
                    <span>جاري تسجيل البيانات...</span>
                }
                else
                {
                    <span>حفظ وتوثيق العقد</span>
                }
            </button>
            <a href="/dashboard" class="rounded-2xl border-2 border-slate-100 bg-white px-8 py-4 text-sm font-bold text-slate-600 transition-all hover:bg-slate-50">إلغاء</a>
        </div>
    </EditForm>
</div>

@code {
    private readonly AddContractFormModel _model = new()
    {
        ContractDate = DateTime.Today
    };

    private List<GovContracts.Web.Models.ContractAttachmentInputModel> _attachments = [];
    private bool _isSubmitting;
    private bool _isSuccess;
    private string? _statusMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthSession.IsLoggedInAsync())
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        await LoadAttachmentTemplatesAsync();
    }

    private async Task HandleSubmitAsync()
    {
        _isSubmitting = true;
        _statusMessage = null;

        if (HasMissingRequiredAttachments())
        {
            _isSubmitting = false;
            _isSuccess = false;
            _statusMessage = "يوجد مرفق مطلوب لم يتم رفعه.";
            return;
        }

        var success = await ContractsApi.CreateAsync(
            _model.ContractName,
            _model.ContractDescription,
            _model.ContractDate,
            _model.ContractValue,
            _attachments);
        _isSuccess = success;
        _statusMessage = success ? "تم حفظ العقد بنجاح." : "تعذر حفظ العقد، حاول مرة أخرى.";
        _isSubmitting = false;

        if (success)
        {
            _model.ContractName = string.Empty;
            _model.ContractDescription = string.Empty;
            _model.ContractDate = DateTime.Today;
            _model.ContractValue = 0m;
            await LoadAttachmentTemplatesAsync();
        }
    }

    private void OnAttachmentFileSelected(
        GovContracts.Web.Models.ContractAttachmentInputModel attachment,
        InputFileChangeEventArgs eventArgs)
    {
        attachment.AttachmentFile = eventArgs.File;
    }

    private bool HasMissingRequiredAttachments()
    {
        return _attachments.Any(attachment => attachment.IsRequired && attachment.AttachmentFile is null);
    }

    private async Task LoadAttachmentTemplatesAsync()
    {
        var templates = await AttachmentTemplatesApi.GetAllAsync();
        _attachments = templates
            .OrderByDescending(template => template.IsRequired)
            .ThenBy(template => template.Name)
            .Select(template => new GovContracts.Web.Models.ContractAttachmentInputModel
            {
                TemplateId = template.Id,
                AttachmentName = template.Name,
                IsRequired = template.IsRequired
            })
            .ToList();
    }

    private class AddContractFormModel
    {
        [Required(ErrorMessage = "اسم العقد مطلوب")]
        public string ContractName { get; set; } = string.Empty;

        [Required(ErrorMessage = "وصف العقد مطلوب")]
        public string ContractDescription { get; set; } = string.Empty;

        [Required(ErrorMessage = "تاريخ العقد مطلوب")]
        public DateTime ContractDate { get; set; }

        [Required(ErrorMessage = "قيمة العقد مطلوبة")]
        [Range(typeof(decimal), "0.01", "79228162514264337593543950335", ErrorMessage = "قيمة العقد يجب أن تكون أكبر من صفر")]
        public decimal ContractValue { get; set; }
    }
}
