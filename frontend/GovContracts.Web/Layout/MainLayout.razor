@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject GovContracts.Web.Services.AuthSessionService AuthSession

@{
    var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower().TrimEnd('/');
    var isLoginPage = currentPath == "login";
    var isDashboard = currentPath == "" || currentPath == "dashboard";
    var isAddContract = currentPath == "contracts/add";
}

<div class="min-h-screen bg-slate-50 text-slate-800 font-cairo" dir="rtl">
    <div class="flex min-h-screen">
        @if (!isLoginPage)
        {
            <!-- Mobile menu overlay -->
            @if (_mobileMenuOpen)
            {
                <div class="fixed inset-0 z-40 bg-black/30 backdrop-blur-sm md:hidden" @onclick="() => _mobileMenuOpen = false"></div>
            }

            <!-- Sidebar -->
            <aside class="@(_mobileMenuOpen ? "translate-x-0" : "translate-x-full md:translate-x-0") fixed inset-y-0 right-0 z-50 w-72 border-l border-slate-200 bg-white shadow-lg md:shadow-sm md:static md:z-auto transition-transform duration-300">
                <div class="border-b border-slate-100 p-6">
                    <p class="text-[10px] font-bold text-identity-gold uppercase tracking-wider">المملكة العربية السعودية</p>
                    <h2 class="mt-1 text-lg font-bold text-identity-green">إدارة العقود الحكومية</h2>
                </div>
                <nav class="p-4 space-y-1">
                    <a class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition-all @(isDashboard ? "nav-link-active" : "text-slate-500 hover:bg-slate-50 hover:text-slate-700")" href="/dashboard">
                        <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" /></svg>
                        <span>لوحة التحكم</span>
                    </a>
                    <a class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm transition-all @(isAddContract ? "nav-link-active" : "text-slate-500 hover:bg-slate-50 hover:text-slate-700")" href="/contracts/add">
                        <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        <span>إضافة عقد جديد</span>
                    </a>
                </nav>

                <!-- Sidebar footer -->
                <div class="absolute bottom-0 left-0 right-0 border-t border-slate-100 p-4">
                    <div class="flex items-center gap-3 rounded-xl bg-slate-50 px-4 py-3">
                        <div class="flex h-9 w-9 items-center justify-center rounded-full bg-identity-green text-white text-xs font-bold shrink-0">
                            @(_displayName?.Length > 0 ? _displayName[0].ToString() : "م")
                        </div>
                        <div class="min-w-0">
                            <p class="text-sm font-bold text-slate-700 truncate">@(_displayName ?? "مستخدم")</p>
                            <p class="text-[11px] text-slate-400">مسؤول النظام</p>
                        </div>
                    </div>
                </div>
            </aside>
        }

        <main class="flex-1 min-w-0">
            @if (!isLoginPage)
            {
                <header class="sticky top-0 z-30 border-b border-slate-200 bg-white/80 px-6 py-4 backdrop-blur-md">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-4">
                            <!-- Mobile menu button -->
                            <button class="md:hidden flex items-center justify-center h-10 w-10 rounded-xl border border-slate-200 text-slate-500 hover:bg-slate-50 transition-all" @onclick="() => _mobileMenuOpen = !_mobileMenuOpen">
                                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
                            </button>
                            <div>
                                <p class="text-xs text-slate-400">نظام توريد الخدمات والسلع</p>
                                <h1 class="text-lg font-bold text-identity-green">بوابة العقود الإلكترونية</h1>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="hidden sm:inline text-sm text-slate-500">مرحبًا، <span class="font-bold text-slate-700">@(_displayName ?? "مستخدم")</span></span>
                            <button class="rounded-xl bg-identity-red/10 text-identity-red px-5 py-2.5 text-xs font-bold hover:bg-identity-red hover:text-white transition-all" @onclick="LogoutAsync">تسجيل الخروج</button>
                        </div>
                    </div>
                </header>
            }

            <article class="mx-auto max-w-7xl p-6 page-enter">
                @Body
            </article>
        </main>
    </div>
</div>

@code {
    private bool _mobileMenuOpen;
    private string? _displayName;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        _displayName = await AuthSession.GetDisplayNameAsync();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _mobileMenuOpen = false;
        StateHasChanged();
    }

    private async Task LogoutAsync()
    {
        await AuthSession.ClearAsync();
        Navigation.NavigateTo("/login", true);
    }
}
